class Solution {
public:
    int minDepth(TreeNode* root) {

        

        // only right child exists
        if (root->left == NULL)
            return minDepth(root->right) + 1;

        // only left child exists
        if (root->right == NULL)
            return minDepth(root->left) + 1;

        // both children exist
        return min(minDepth(root->left),
                   minDepth(root->right)) + 1;
    }
};
